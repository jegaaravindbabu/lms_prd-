# ---------------------------------------------------------------------------
#  Environment configuration
# ---------------------------------------------------------------------------

# App-facing Postgres connection. Connect as the RLS-SUBJECT role (app_user).
# Every tenant query goes through withTenant() and is filtered by RLS.
DATABASE_URL="postgresql://app_user:password@localhost:5432/lms?schema=public"

# Platform/admin + migrations. Connect as the BYPASSRLS role (platform_admin).
# NEVER expose this to tenant-facing request handlers.
DATABASE_ADMIN_URL="postgresql://platform_admin:password@localhost:5432/lms?schema=public"

# The platform base domain. Subdomains of this host resolve to a Tenant.subdomain.
#   e.g. NEXT_PUBLIC_ROOT_DOMAIN=yourplatform.com  ->  physicswala.yourplatform.com
NEXT_PUBLIC_ROOT_DOMAIN="lvh.me:3000"

# Secret used to sign session JWTs (use a long random string in production).
AUTH_SECRET="dev-only-change-me-to-a-32+char-random-string"

# OTP delivery mode. "console" prints the code to the server log (dev).
# Swap for a real SMS provider (Twilio/MSG91/etc.) in production.
OTP_MODE="console"

# Encryption key (32 bytes, base64) for gateway credentials at rest.
# Generate: openssl rand -base64 32
CREDENTIAL_ENC_KEY=""
